# Public browser key: restrict by HTTP referrer and to Maps JavaScript API + Places API (New).
# VITE_* values are bundled into the browser and must not contain server secrets.
VITE_PUBLIC_APP_URL=http://192.168.1.10:5173
VITE_API_URL=http://192.168.1.10:5000
VITE_GOOGLE_MAPS_BROWSER_KEY=

# Public browser key: restrict allowed referrers/origins and enable only Geoapify Geocoding + Places APIs.
VITE_GEOAPIFY_API_KEY=

# Maximum sequential Places calls per selected area. Values are capped at 32.
VITE_GEOAPIFY_MAX_AREA_REQUESTS=16
