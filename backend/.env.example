PORT=5000
BACKEND_PUBLIC_URL=http://localhost:5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/bookverse?retryWrites=true&w=majority
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_APP_PASS=your_16_character_google_app_password

# Server-side Geoapify key for the /api/geoapify proxy (bookstore map search).
# Keep this secret server-side; the frontend must never hold a Geoapify key.
# If the old key was ever committed to the frontend, rotate it in the Geoapify dashboard.
GEOAPIFY_API_KEY=
